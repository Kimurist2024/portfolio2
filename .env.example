# Contact form (Resend) — set these in Vercel → Project → Settings → Environment Variables.
# The contact API returns 503 until RESEND_API_KEY is present, so the site still
# builds and runs without it (the mailto link keeps working).

# Resend API key. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Inbox that receives contact submissions. Pinned server-side; never sent by the client.
# Defaults to ryuhki2003@gmail.com if unset.
CONTACT_TO_EMAIL=

# Verified Resend sender. Must be on a domain you verified in Resend.
# Defaults to onboarding@resend.dev (Resend's shared test sender) if unset.
CONTACT_FROM_EMAIL=
